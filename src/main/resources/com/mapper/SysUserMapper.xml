<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mapper.SysUserMapper">

    <!-- 查询所有用户列表 -->
    <select id="findAll" resultType="com.pojo.SysUser">
        SELECT id, username, password, email, create_time 
        FROM sys_user 
        ORDER BY create_time DESC
    </select>

    <!-- 更新用户信息 -->
    <update id="update" parameterType="com.pojo.SysUser">
        UPDATE sys_user
        SET 
            username = #{username},
            password = #{password},
            email = #{email}
        WHERE id = #{id}
    </update>

    <!-- 根据用户ID删除用户 -->
    <delete id="deleteById" parameterType="Integer">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

</mapper>
